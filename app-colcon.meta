{
  "names": {
    "microxrcedds_client": {
      "cmake-args": ["-DUCLIENT_UDP_TRANSPORT_MTU=1400"]
    },
    "rmw_microxrcedds": {
      "cmake-args": [
        "-DRMW_UXRCE_TRANSPORT=udp",
        "-DRMW_UXRCE_STREAM_HISTORY=8",
        "-DRMW_UXRCE_MAX_NODES=1",
        "-DRMW_UXRCE_MAX_PUBLISHERS=1",
        "-DRMW_UXRCE_TOPIC_NAME_MAX_LENGTH=164",
        "-DRMW_UXRCE_NODE_NAME_MAX_LENGTH=96",
        "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=0",
        "-DRMW_UXRCE_MAX_SERVICES=0",
        "-DRMW_UXRCE_MAX_CLIENTS=0",
        "-DRMW_UXRCE_MAX_HISTORY=1"
      ]
    }
  }
}
